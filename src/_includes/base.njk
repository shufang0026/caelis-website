<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} — {% endif %}{{ site.gallery_name }}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bg: '#FAFAFA',
            surface: '#FFFFFF',
            text: '#111111',
            primary: '#000000',
            secondary: '#444444',
            muted: '#666666',
          },
          fontFamily: {
            display: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            body: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>
  
  <style>
    /* Custom base styles */
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: #FAFAFA;
      color: #111111;
    }
    .font-display {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    
    /* Page transitions */
    html {
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #FAFAFA;
    }
    ::-webkit-scrollbar-thumb {
      background: #444;
      border-radius: 3px;
    }
    
    /* Ken Burns hero animation */
    @keyframes kenBurns {
      0% { transform: scale(1); }
      100% { transform: scale(1.08); }
    }
    .hero-ken-burns {
      animation: kenBurns 20s ease-in-out alternate infinite;
    }
    
    /* Scroll reveal */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    
    /* Dark dramatic section — DZ style */
    .dark-dramatic {
      background: #000;
    }
    
    /* Hide scrollbar on mobile */
    @media (max-width: 768px) {
      ::-webkit-scrollbar {
        display: none;
      }
    }
    
    /* Focus states */
    :focus-visible {
      outline: 2px solid #2C2C2C;
      outline-offset: 2px;
    }
    
    /* Aspect ratio boxes for placeholders */
    .aspect-artwork {
      aspect-ratio: 3/4;
    }
    .aspect-hero {
      aspect-ratio: 16/9;
    }
    .aspect-square {
      aspect-ratio: 1/1;
    }
    
    /* Gradient placeholders matching original design */
    .gradient-placeholder-1 {
      background: linear-gradient(135deg, #E8E4E0 0%, #D4CFC8 50%, #C5BFB6 100%);
    }
    .gradient-placeholder-2 {
      background: linear-gradient(135deg, #E0DCD8 0%, #CEC9C2 50%, #BEB7AE 100%);
    }
    .gradient-placeholder-3 {
      background: linear-gradient(135deg, #D8D4D0 0%, #C4BFB8 50%, #B0A9A0 100%);
    }
    .gradient-placeholder-4 {
      background: linear-gradient(135deg, #E4E0DC 0%, #CCC7C0 50%, #B4ADA8 100%);
    }
  </style>
</head>
<body class="bg-bg font-body antialiased min-h-screen flex flex-col">
  
  {% include "nav.njk" %}
  
  <main class="flex-1">
    {{ content | safe }}
  </main>
  
  {% include "footer.njk" %}
  
  <!-- Netlify Identity Widget (handles invite, reset, confirmation tokens from URL hash) -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      netlifyIdentity.on("init", function(user) {
        // If user just completed invite/password-reset, redirect to admin
        if (user && window.location.hash.includes('token')) {
          window.location.hash = '';
          window.location.href = '/admin';
        }
      });
    }
  </script>

  <!-- Mobile menu script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuOverlay = document.getElementById('menu-overlay');
      
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', function() {
          mobileMenu.classList.toggle('hidden');
          menuOverlay.classList.toggle('hidden');
          document.body.classList.toggle('overflow-hidden');
        });
        
        menuOverlay.addEventListener('click', function() {
          mobileMenu.classList.add('hidden');
          menuOverlay.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        });
      }
      
      // Close mobile menu on escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          mobileMenu.classList.add('hidden');
          menuOverlay.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });
    });

    // Gallery Carousel
    (function() {
      var track = document.getElementById('gallery-track');
      var prevBtn = document.getElementById('gallery-prev');
      var nextBtn = document.getElementById('gallery-next');
      var dots = document.querySelectorAll('.gallery-dot');
      if (!track || !prevBtn || !nextBtn) return;
      var items = track.querySelectorAll('[style*="width"]');
      var total = items.length;
      var current = 0;
      function update() {
        var pct = -(current * (100 / total));
        track.style.transform = 'translateX(' + pct + '%)';
        dots.forEach(function(d, i) {
          d.className = 'gallery-dot w-2 h-2 rounded-full transition-colors ' + (i === current ? 'bg-text' : 'bg-gray-300');
        });
      }
      prevBtn.addEventListener('click', function() {
        current = (current - 1 + total) % total;
        update();
      });
      nextBtn.addEventListener('click', function() {
        current = (current + 1) % total;
        update();
      });
      dots.forEach(function(dot, i) {
        dot.addEventListener('click', function() {
          current = i;
          update();
        });
      });
    })();
  </script>
  <!-- Scroll Reveal -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var reveals = document.querySelectorAll('.reveal');
      if (!reveals.length) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    });
  </script>
</body>
</html>
