    <p id="inquiry-artwork-label" style="font-family:'Inter',sans-serif;font-size:11px;color:#888;margin-bottom:1.25rem;"></p>
    <form onsubmit="submitInquiry(event)">
      <input type="hidden" id="inquiry-artwork" name="artwork" value="" />
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label style="display:block;font-family:'Inter',sans-serif;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:#999;margin-bottom:4px;">Full Name</label>
          <input type="text" name="name" required style="width:100%;border:none;border-bottom:1px solid #ddd;padding:6px 0;font-size:13px;color:#111;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-family:'Inter',sans-serif;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:#999;margin-bottom:4px;">Email</label>
          <input type="email" name="email" required style="width:100%;border:none;border-bottom:1px solid #ddd;padding:6px 0;font-size:13px;color:#111;outline:none;" />
        </div>
        <div>
          <label style="display:block;font-family:'Inter',sans-serif;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:#999;margin-bottom:4px;">Message</label>
          <textarea name="message" rows="3" style="width:100%;border:none;border-bottom:1px solid #ddd;padding:6px 0;font-size:13px;color:#111;outline:none;resize:none;" placeholder="I would like to inquire about..."></textarea>
        </div>
        <button type="submit" style="width:100%;background:#111;color:#fff;font-family:'Inter',sans-serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;padding:12px;border:none;cursor:pointer;margin-top:0.5rem;">Send Inquiry</button>
        <p id="inquiry-success" style="display:none;font-family:'Inter',sans-serif;font-size:12px;color:#16a34a;text-align:center;margin-top:0.5rem;">Thank you! We will be in touch.</p>
      </div>
    </form>
  </div>
</div>

<script>
  function openInquiry(title, year, medium, dims) {
    document.getElementById('inquiry-artwork').value = title + ', ' + year + ', ' + medium + ', ' + dims;
    document.getElementById('inquiry-artwork-label').textContent = title + ', ' + year + ' · ' + medium + ' · ' + dims;
    document.getElementById('inquiry-modal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeInquiry() {
    document.getElementById('inquiry-modal').classList.remove('open');
    document.body.style.overflow = '';
  }
  async function submitInquiry(e) {
    e.preventDefault();
    var form = e.target;
    var data = {
      type: 'inquiry',
      name: form.name.value,
      email: form.email.value,
      message: form.message.value,
      artwork: document.getElementById('inquiry-artwork').value,
      source: 'jaime-sancorlo-online'
    };
    try {
      var res = await fetch('https://caelis-subscribe.shufang0026.workers.dev/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        document.getElementById('inquiry-success').style.display = 'block';
        form.reset();
        setTimeout(function() { closeInquiry(); document.getElementById('inquiry-success').style.display = 'none'; }, 2500);
      }
    } catch(err) { alert('Something went wrong. Please email info@caelis.cn'); }
  }
</script>
