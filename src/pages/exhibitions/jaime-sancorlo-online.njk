  { "title": "Hail to the Bus Driver", "year": "2023", "medium": "Oil on canvas", "dimensions": "89 × 116 cm", "image": "/images/artworks/jaime-sancorlo/hail-to-the-bus-driver-89x116-2023.jpg", "layout": "center" },
  { "title": "Lying in Wait", "year": "2023", "medium": "Oil on canvas", "dimensions": "70 × 50 cm", "image": "/images/artworks/jaime-sancorlo/lying-in-wait-70x50cm-2023.jpg", "layout": "right" },
  { "title": "No Parking", "year": "2023", "medium": "Oil on canvas", "dimensions": "100 × 81 cm", "image": "/images/artworks/jaime-sancorlo/no-parking-100x81cm-2023.jpg", "layout": "left" },
  { "title": "Of Course You Realize This Means War!!", "year": "2023", "medium": "Oil on canvas", "dimensions": "73 × 100 cm", "image": "/images/artworks/jaime-sancorlo/of-course-you-realize-this-means-war-73x100cm-2023.jpg", "layout": "center" },
  { "title": "On Ice", "year": "2023", "medium": "Oil on canvas", "dimensions": "89 × 130 cm", "image": "/images/artworks/jaime-sancorlo/on-ice-89x130cm-2023.jpg", "layout": "right" },
  { "title": "Qué Será Será", "year": "2023", "medium": "Oil on canvas", "dimensions": "89 × 116 cm", "image": "/images/artworks/jaime-sancorlo/que-sera-sera-89x116cm-2023.jpg", "layout": "left" },
  { "title": "Reach Out", "year": "2023", "medium": "Oil on canvas", "dimensions": "65 × 92 cm", "image": "/images/artworks/jaime-sancorlo/reach-out-65x92cm-2023.jpg", "layout": "center" },
  { "title": "Storyteller", "year": "2023", "medium": "Oil on canvas", "dimensions": "89 × 130 cm", "image": "/images/artworks/jaime-sancorlo/storyteller-89x130cm-2023.jpg", "layout": "right" },
