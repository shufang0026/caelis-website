<style>
  .artwork-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .artwork-card {
    cursor: pointer;
    overflow: hidden;
    background: #f5f5f5;
  }
  .artwork-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: block;
  }
  .artwork-card:hover img {
    transform: scale(1.04);
  }
  .artwork-card-info {
    padding: 1rem 0 0.5rem;
    transition: opacity 0.2s;
  }
  .artwork-card:hover .artwork-card-info {
    opacity: 0.7;
  }

  /* Lightbox */
  #artwork-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.97);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #artwork-lightbox.active {
    opacity: 1;
    pointer-events: all;
  }
  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 2rem;
    gap: 2rem;
  }
  .lightbox-image-wrap {
    flex: 1;
    max-width: calc(100% - 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .lightbox-image-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .lightbox-info {
    width: 280px;
    flex-shrink: 0;
    color: #fff;
    padding: 1rem 0;
  }
  .lightbox-nav {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }
  .lightbox-nav:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.4);
  }
  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    z-index: 10;
  }
  .lightbox-close:hover {
    background: rgba(255,255,255,0.1);
  }
  @media (max-width: 768px) {
    .lightbox-content {
      flex-direction: column;
      padding: 1rem;
      gap: 1rem;
    }
    .lightbox-info {
      width: 100%;
      text-align: center;
      order: 2;
      padding: 0;
    }
    .lightbox-image-wrap {
      max-width: 100%;
      order: 1;
      height: 60vh;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
    }
    #lightbox-prev { left: 0.5rem; }
    #lightbox-next { right: 0.5rem; }
    .artwork-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 0.75rem;
    }
  }
</style>

<!-- Exhibition Header -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
  <a href="/exhibitions/" class="inline-flex items-center text-[11px] tracking-[0.25em] uppercase text-secondary hover:text-text transition-colors group mb-12">
    <svg class="mr-2 w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
    Exhibitions
  </a>

  <div class="max-w-2xl">
    <p class="text-[11px] tracking-[0.25em] uppercase text-secondary mb-4">Online Exhibition</p>
    <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl font-light text-text mb-4 leading-tight">Jaime Sancorlo</h1>
    <p class="text-lg text-secondary">Madrid, 1980 —</p>
  </div>
</section>

<!-- Artworks Grid -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
  <div class="artwork-grid">
    {% for artwork in artworks %}
    <div class="artwork-card group" data-index="{{ loop.index0 }}" onclick="openLightbox({{ loop.index0 }})">
      <img src="{{ artwork.image }}" alt="{{ artwork.title }}" loading="lazy" />
      <div class="artwork-card-info">
        <p class="text-sm font-medium text-text leading-snug">{{ artwork.title }}</p>
        <p class="text-xs text-secondary mt-0.5">{{ artwork.year }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- Lightbox -->
<div id="artwork-lightbox" role="dialog" aria-modal="true" aria-label="Artwork detail">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <button id="lightbox-prev" class="lightbox-nav" onclick="prevArtwork(event)" aria-label="Previous">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
  </button>

  <div class="lightbox-content">
    <div class="lightbox-image-wrap">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-info">
      <p id="lightbox-title" class="font-display text-2xl font-light text-white mb-1 leading-snug"></p>
      <p id="lightbox-year" class="text-sm text-gray-400 mb-4"></p>
      <p id="lightbox-medium" class="text-xs text-gray-500 uppercase tracking-wider mb-1"></p>
      <p id="lightbox-dimensions" class="text-xs text-gray-500 uppercase tracking-wider mb-8"></p>
      <p class="text-[11px] tracking-[0.2em] uppercase text-gray-400 mb-2">Jaime Sancorlo</p>
      <p class="text-[10px] text-gray-600">Caelis Galería, Shanghai</p>
      <div class="mt-8">
        <a id="lightbox-inquire" href="#" onclick="event.preventDefault(); document.getElementById('inquiry-form').classList.remove('hidden'); closeLightbox();" class="inline-block text-[11px] tracking-[0.2em] uppercase border border-gray-500 text-gray-300 px-6 py-2.5 hover:bg-white hover:text-black transition-colors">
          Inquire
        </a>
      </div>
    </div>
  </div>

  <button id="lightbox-next" class="lightbox-nav" onclick="nextArtwork(event)" aria-label="Next">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<!-- Hidden Inquiry Form -->
<div id="inquiry-form" class="hidden fixed inset-0 bg-black/60 z-[10000] flex items-center justify-center p-4">
  <div class="bg-white w-full max-w-md p-8 rounded-sm shadow-2xl">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-display text-xl font-light text-text">Inquire</h3>
      <button onclick="document.getElementById('inquiry-form').classList.add('hidden')" class="text-secondary hover:text-text">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="inquiry-form-el" onsubmit="submitInquiry(event)">
      <input type="hidden" id="inquiry-artwork" name="artwork" value="" />
      <div class="space-y-4">
        <div>
          <label class="block text-[11px] tracking-[0.15em] uppercase text-secondary mb-1">Full Name</label>
          <input type="text" name="name" required class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors" />
        </div>
        <div>
          <label class="block text-[11px] tracking-[0.15em] uppercase text-secondary mb-1">Email</label>
          <input type="email" name="email" required class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors" />
        </div>
        <div>
          <label class="block text-[11px] tracking-[0.15em] uppercase text-secondary mb-1">Message</label>
          <textarea name="message" rows="3" class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors resize-none" placeholder="I would like to inquire about..."></textarea>
        </div>
        <button type="submit" class="w-full bg-black text-white text-[11px] tracking-[0.2em] uppercase py-3 hover:bg-gray-800 transition-colors">
          Send Inquiry
        </button>
        <p id="inquiry-success" class="hidden text-sm text-green-600 text-center mt-2">Thank you! We will be in touch shortly.</p>
      </div>
    </form>
  </div>
</div>

<script>
  const artworks = {{ artworks | dump | safe }};
  let currentIndex = 0;

  function openLightbox(index) {
    currentIndex = index;
    updateLightbox();
    document.getElementById('artwork-lightbox').classList.add('active');
    document.body.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    document.getElementById('artwork-lightbox').classList.remove('active');
    document.body.classList.remove('overflow-hidden');
  }

  function updateLightbox() {
    const a = artworks[currentIndex];
    document.getElementById('lightbox-img').src = a.image;
    document.getElementById('lightbox-img').alt = a.title;
    document.getElementById('lightbox-title').textContent = a.title;
    document.getElementById('lightbox-year').textContent = a.year;
    document.getElementById('lightbox-medium').textContent = a.medium;
    document.getElementById('lightbox-dimensions').textContent = a.dimensions;
    document.getElementById('lightbox-inquire').onclick = function(e) {
      e.preventDefault();
      document.getElementById('inquiry-artwork').value = a.title + ', ' + a.year + ', ' + a.medium + ', ' + a.dimensions;
      document.getElementById('inquiry-form').classList.remove('hidden');
      closeLightbox();
    };
  }

  function prevArtwork(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex - 1 + artworks.length) % artworks.length;
    updateLightbox();
  }

  function nextArtwork(e) {
    if (e) e.stopPropagation();
    currentIndex = (currentIndex + 1) % artworks.length;
    updateLightbox();
  }

  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('artwork-lightbox').classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevArtwork();
    if (e.key === 'ArrowRight') nextArtwork();
  });

  document.getElementById('artwork-lightbox').addEventListener('click', function(e) {
    if (e.target === this) closeLightbox();
  });

  async function submitInquiry(e) {
    e.preventDefault();
    const form = e.target;
    const data = {
      type: 'inquiry',
      name: form.name.value,
      email: form.email.value,
      message: form.message.value,
      artwork: document.getElementById('inquiry-artwork').value,
      source: 'jaime-sancorlo-online-exhibition'
    };
    try {
      const res = await fetch('https://caelis-subscribe.shufang0026.workers.dev/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        document.getElementById('inquiry-success').classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          document.getElementById('inquiry-form').classList.add('hidden');
          document.getElementById('inquiry-success').classList.add('hidden');
        }, 3000);
      }
    } catch(err) {
      alert('Something went wrong. Please email us at info@caelis.cn');
    }
  }
</script>
