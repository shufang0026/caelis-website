<!-- Visitor Gate Logic -->
<script>
(function() {
  var gate = document.getElementById('visitor-gate');
  var form = document.getElementById('visitor-form');
  var success = document.getElementById('vg-success');
  var error = document.getElementById('vg-error');
  var submitBtn = document.getElementById('vg-submit');

  // Check if user already has access (7 days)
  var accessData = localStorage.getItem('caelis_exhibition_access');
  if (accessData) {
    try {
      var data = JSON.parse(accessData);
      var expiry = new Date(data.expiresAt);
      if (expiry > new Date()) {
        gate.classList.add('hidden');
        return;
      }
    } catch(e) {}
  }

  window.submitVisitor = async function(e) {
    e.preventDefault();
    error.classList.remove('show');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Please wait...';

    var interests = [];
    var interestSelect = document.getElementById('vg-interests');
    if (interestSelect) {
      for (var i = 0; i < interestSelect.options.length; i++) {
        if (interestSelect.options[i].selected) {
          interests.push(interestSelect.options[i].value);
        }
      }
    }

    var payload = {
      firstName: document.getElementById('vg-firstName').value.trim(),
      lastName: document.getElementById('vg-lastName').value.trim(),
      email: document.getElementById('vg-email').value.trim(),
      country: document.getElementById('vg-country').value,
      role: document.getElementById('vg-role').value,
      interests: interests,
      source: document.getElementById('vg-source').value,
      notes: document.getElementById('vg-notes').value.trim(),
      wantsNewsletter: document.getElementById('vg-newsletter').checked,
      exhibition: 'jaime-sancorlo-reach-out'
    };

    try {
      var res = await fetch('https://caelis-subscribe-production.shufang0026.workers.dev/visitor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: payload })
      });
      var result = await res.json();

      if (res.ok) {
        var expires = new Date();
        expires.setDate(expires.getDate() + 7);
        localStorage.setItem('caelis_exhibition_access', JSON.stringify({
          email: payload.email,
          exhibition: payload.exhibition,
          expiresAt: expires.toISOString()
        }));

        form.style.display = 'none';
        success.classList.add('show');
        setTimeout(function() {
          gate.classList.add('hidden');
        }, 2000);
      } else {
        error.textContent = result.error || 'Something went wrong. Please try again.';
        error.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enter Exhibition';
      }
    } catch(err) {
      error.textContent = 'Network error. Please check your connection and try again.';
      error.classList.add('show');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enter Exhibition';
    }
  };
})();
</script>
