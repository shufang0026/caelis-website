  { "title": "Yeah, But You Should See the Other Truck!", "year": "2023", "medium": "Oil on wood panel", "dimensions": "100 × 73 cm", "image": "/images/artworks/jaime-sancorlo/yeah-but-you-should-see-the-other-truck-100x73cm-2023.jpg", "layout": "right" }
] %}

<style>
  .page-wrap { max-width: 100% !important; padding: 0 !important; }

  /* ── Intro with artist info ── */
  .ex-intro {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 6vw;
  }

  .intro-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    width: 100%;
    max-width: 1200px;
    align-items: center;
  }
  .intro-left { }
  .intro-right { }

  .intro-right .artist-photo {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 3/4;
    object-fit: cover;
  }

  .intro-right .artist-bio {
    margin-top: 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.75;
    color: #666;
    max-width: 360px;
  }

  .intro-right .artist-bio strong {
    color: #333;
    font-weight: 500;
  }

  .intro-meta-line {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #999;
    margin-top: 2.5rem;
  }

  .intro-scroll-hint {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 48px;
    background: #999;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { opacity: .3 }
    50% { opacity: 1 }
  }

  /* ── Text interlude ── */
  .ex-text {
    max-width: 560px;
    padding: 8vh 6vw;
  }
  .ex-text.align-right { margin-left: auto; }
  .ex-text.align-left { margin-right: auto; }
  .ex-text.align-center { margin-left: auto; margin-right: auto; }
  .ex-text p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.85;
    color: #555;
  }
  .ex-text p + p { margin-top: 1em; }

  /* ── Artwork sections ── */
  .artwork-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 3rem 0;
  }

  .artwork-section.layout-center { justify-content: center; }
  .artwork-section.layout-center .artwork-image { max-width: 68vw; max-height: 80vh; }

  .artwork-section.layout-left { justify-content: flex-start; padding-left: 4vw; }
  .artwork-section.layout-left .artwork-image { max-width: 52vw; max-height: 80vh; }
  .artwork-section.layout-left .artwork-meta {
    left: auto; right: 6vw; top: 50%; transform: translateY(-50%); bottom: auto; max-width: 280px;
  }

  .artwork-section.layout-right { justify-content: flex-end; padding-right: 4vw; }
  .artwork-section.layout-right .artwork-image { max-width: 52vw; max-height: 80vh; }
  .artwork-section.layout-right .artwork-meta {
    left: 6vw; top: 50%; transform: translateY(-50%); bottom: auto; max-width: 280px;
  }

  .artwork-image {
    object-fit: contain;
    transition: transform 0.6s cubic-bezier(.25,.46,.45,.94);
  }
  .artwork-image:hover { transform: scale(1.015); }

  .artwork-meta {
    position: absolute;
    bottom: 3rem;
    left: 3rem;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 10;
  }
  .artwork-section:hover .artwork-meta,
  .artwork-section.touch-device .artwork-meta { opacity: 1; }

  .artwork-counter {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #aaa;
    z-index: 10;
  }

  .inquire-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #999;
    border-bottom: 1px solid #ccc;
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
  }
  .inquire-link:hover { color: #333; border-color: #333; }

  /* ── Nav dots ── */
  .nav-dots {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 100;
  }
  .nav-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
    transition: background .3s, transform .3s;
    border: none; padding: 0;
  }
  .nav-dot.active { background: #333; transform: scale(1.5); }
  .nav-dot:hover { background: #666; }

  /* ── Back to top ── */
  .back-top {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999;
    cursor: pointer;
    opacity: 0;
    transition: opacity .3s;
    z-index: 100;
    background: none; border: none;
  }
  .back-top.visible { opacity: 1; }
  .back-top:hover { color: #333; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .intro-right { text-align: center; }
    .intro-right .artist-photo { max-width: 200px; margin: 0 auto; }
    .intro-right .artist-bio { max-width: none; margin-left: auto; margin-right: auto; }
    .ex-intro { min-height: auto; padding: 8rem 1.5rem 4rem; }
    .ex-intro .intro-scroll-hint { display: none; }

    .artwork-section.layout-left,
    .artwork-section.layout-right,
    .artwork-section.layout-center {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
    }
    .artwork-section.layout-left .artwork-image,
    .artwork-section.layout-right .artwork-image { max-width: 88vw; }
    .artwork-section.layout-center .artwork-image { max-width: 88vw; }
    .artwork-section.layout-left .artwork-meta,
    .artwork-section.layout-right .artwork-meta {
      left: 1.5rem; right: 1.5rem; top: auto; bottom: 1.5rem;
      transform: none; max-width: none; opacity: 1;
    }
    .artwork-meta { opacity: 1; }
    .ex-text { padding: 4vh 1.5rem; }
    .nav-dots { right: .75rem; gap: 6px; }
    .nav-dot { width: 5px; height: 5px; }
  }

  /* ── Inquiry modal ── */
  .inquiry-modal {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.5);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s;
  }
  .inquiry-modal.open { opacity: 1; pointer-events: all; }
  .inquiry-modal-box {
    background: #fff;
    width: 100%;
    max-width: 440px;
    padding: 2.5rem;
  }
</style>

<!-- ═══════════════ INTRO ═══════════════ -->
<section class="ex-intro" style="position:relative;">
  <div class="intro-inner">
    <div class="intro-left">
      <a href="/exhibitions/" class="inline-flex items-center text-[11px] tracking-[0.25em] uppercase text-secondary hover:text-text transition-colors group mb-12">
        <svg class="mr-2 w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
        Exhibitions
      </a>
      <p class="font-body text-[11px] tracking-[0.3em] uppercase text-secondary mb-5">Online Exhibition</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-light text-text mb-3 leading-[0.95]">Reach Out</h1>
      <p class="font-display text-2xl sm:text-3xl font-light text-secondary mb-8">Jaime Sancorlo</p>
      <p class="intro-meta-line">August 15 — September 28, 2023 &nbsp;·&nbsp; Caelis Galería, Shanghai</p>
    </div>
    <div class="intro-right">
      <img class="artist-photo" src="/images/artists/jaime-sancorlo.jpeg" alt="Jaime Sancorlo" />
      <div class="artist-bio">
        <strong>Jaime Sancorlo</strong> (Madrid, 1980) began copying characters from films, comics, and cartoons at a very young age. He graduated in Fine Arts from the Complutense University of Madrid and trained at the Academy of Fine Arts in Warsaw on an Erasmus scholarship. In mid-2018, after attending a painting workshop by Alejandro Carpintero, he fell in love again with the practice of oil painting.<br><br>
        Meticulous in his style, Sancorlo feels most comfortable with oil painting — he appreciates its long drying time, its versatility, and its ability to create both soft melts and razor-sharp edges. His work draws from historical black-and-white photographs, injecting playful cartoon elements to explore the absurdity of war and the loss of innocence.
      </div>
    </div>
  </div>
  <div class="intro-scroll-hint"></div>
</section>

<!-- ═══════════════ TEXT 1 ═══════════════ -->
<div class="ex-text align-right">
  <p>Caelis Galería is delighted to present "Reach Out," a solo exhibition by Spanish artist Jaime Sancorlo. The exhibition showcases a series of oil paintings depicting the adult world as a playground of irony. Drawing inspiration from historical black-and-white photographs from difficult periods, he injects a playful and witty touch of cartoon characters to create a juxtaposition of surreal, pop, and ironic elements.</p>
</div>

<!-- ═══════════════ ARTWORKS ═══════════════ -->

{% for artwork in artworks %}
{% if loop.index0 == 2 %}
<!-- TEXT 2 after artwork 3 -->
<div class="ex-text align-left">
  <p>The thirteen artworks presented in the exhibition evoke a serene and quiet wilderness, seemingly untouched by the smoke of war. Each canvas presents a unique theme — from leisure and practice to rescue and armistice — infusing the difficult times captured in the photographs with a soft touch of life and vibrancy.</p>
</div>
{% elif loop.index0 == 4 %}
<!-- TEXT 3 after artwork 5 -->
<div class="ex-text align-center">
  <p>Through his astute artistic prowess, Jaime skillfully transforms the language of photography into a hyperrealistic painting language, prompting profound questions about the interplay between reality and the influx of popular symbols in our collective memory. This artistic montage empowers viewers to naturally fill in the missing narrative pieces, eagerly unraveling the tales suspended within each frame.</p>
</div>
{% elif loop.index0 == 6 %}
<!-- TEXT 4 after artwork 7 -->
<div class="ex-text align-right">
  <p>Behind the layers of historical fragments, Jaime Sancorlo pays tribute to the meticulous detailing of hyperrealism. At first glance, his artworks present an aged and somber black-and-white palette. Yet, beneath the surface, the coarse texture and sharp edges reveal a transformative process of selective treatment, transcending mere reproduction to become an embodiment of carefully chosen authenticity.</p>
</div>
{% elif loop.index0 == 9 %}
<!-- TEXT 5 after artwork 10 -->
<div class="ex-text align-left">
  <p>The personas encountered amidst these trying times are adorned with military signifiers, mirroring the somber aspects of adulthood. The acid-colored cartoon elements reference electronic games and American movies, pointing to a forgotten childhood, expressing the loss of innocence and contemplation of its reasons, and attempting to find a trace of a smile amidst the serious military environment.</p>
</div>
{% endif %}

<section class="artwork-section layout-{{ artwork.layout }}" data-index="{{ loop.index0 }}">
  <img class="artwork-image" src="{{ artwork.image }}" alt="{{ artwork.title }}" loading="lazy" />
  <div class="artwork-meta">
    <p class="font-display text-xl sm:text-2xl font-light text-text leading-snug">{{ artwork.title }}</p>
    <p class="font-body text-xs text-secondary mt-1">{{ artwork.year }}</p>
    <p class="font-body text-[11px] tracking-[0.1em] text-muted mt-2">{{ artwork.medium }}</p>
    <p class="font-body text-[11px] tracking-[0.1em] text-muted">{{ artwork.dimensions }}</p>
    <a href="#" class="inquire-link" onclick="event.preventDefault(); openInquiry('{{ artwork.title }}', '{{ artwork.year }}', '{{ artwork.medium }}', '{{ artwork.dimensions }}')">Inquire</a>
  </div>
  <div class="artwork-counter">{{ loop.index }} / {{ artworks | length }}</div>
</section>

{% endfor %}

<!-- ═══════════════ CLOSING ═══════════════ -->
<div class="ex-text align-center" style="padding-bottom: 12vh;">
  <p>Jaime's artistic craftsmanship, blending restrained and faithful depictions with humorous assemblages, extends an empathetic hand to the numerous harsh realities, encouraging viewers to strike a harmonious balance between introspection and distance. By embracing the past and present, we can build profound consensus, awakening a newfound depth within ourselves.</p>
  <p class="mt-6">
    <a href="mailto:info@caelis.cn" class="inquire-link">Contact the gallery</a>
  </p>
</div>

<!-- ═══════════════ NAV DOTS ═══════════════ -->
<div class="nav-dots" id="nav-dots">
  <button class="nav-dot active" onclick="scrollToSection(0)" aria-label="Intro"></button>
  {% for artwork in artworks %}
  <button class="nav-dot" onclick="scrollToSection({{ loop.index }})" aria-label="{{ artwork.title }}"></button>
  {% endfor %}
</div>

<!-- ═══════════════ BACK TO TOP ═══════════════ -->
<button class="back-top" id="back-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑ Top</button>

<!-- ═══════════════ INQUIRY MODAL ═══════════════ -->
<div class="inquiry-modal" id="inquiry-modal" onclick="if(event.target===this)closeInquiry()">
  <div class="inquiry-modal-box">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-display text-xl font-light text-text">Inquire</h3>
      <button onclick="closeInquiry()" class="text-secondary hover:text-text">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <p id="inquiry-artwork-label" class="font-body text-xs text-secondary mb-5"></p>
    <form onsubmit="submitInquiry(event)">
      <input type="hidden" id="inquiry-artwork" name="artwork" value="" />
      <div class="space-y-4">
        <div>
          <label class="block font-body text-[10px] tracking-[0.15em] uppercase text-secondary mb-1">Full Name</label>
          <input type="text" name="name" required class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors" />
        </div>
        <div>
          <label class="block font-body text-[10px] tracking-[0.15em] uppercase text-secondary mb-1">Email</label>
          <input type="email" name="email" required class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors" />
        </div>
        <div>
          <label class="block font-body text-[10px] tracking-[0.15em] uppercase text-secondary mb-1">Message</label>
          <textarea name="message" rows="3" class="w-full border border-gray-300 px-3 py-2 text-sm text-text focus:outline-none focus:border-text transition-colors resize-none" placeholder="I would like to inquire about..."></textarea>
        </div>
        <button type="submit" class="w-full bg-black text-white font-body text-[11px] tracking-[0.2em] uppercase py-3 hover:bg-gray-800 transition-colors">Send Inquiry</button>
        <p id="inquiry-success" class="hidden font-body text-sm text-green-600 text-center">Thank you! We will be in touch.</p>
      </div>
    </form>
  </div>
</div>

<script>
  if ('ontouchstart' in window) {
    document.querySelectorAll('.artwork-section').forEach(s => s.classList.add('touch-device'));
  }

  const dots = document.querySelectorAll('.nav-dot');
  const backTop = document.getElementById('back-top');
  const allSections = document.querySelectorAll('.ex-intro, .artwork-section');

  const obs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      let idx = 0;
      if (entry.target.classList.contains('artwork-section')) {
        idx = parseInt(entry.target.dataset.index) + 1;
      }
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
      backTop.classList.toggle('visible', idx > 1);
    });
  }, { threshold: 0.4 });

  allSections.forEach(s => obs.observe(s));

  function scrollToSection(idx) {
    if (idx === 0) {
      document.querySelector('.ex-intro').scrollIntoView({ behavior: 'smooth' });
    } else {
      document.querySelectorAll('.artwork-section')[idx - 1]?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  document.addEventListener('keydown', e => {
    if (document.getElementById('inquiry-modal').classList.contains('open')) return;
    const cur = [...dots].findIndex(d => d.classList.contains('active'));
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      e.preventDefault();
      scrollToSection(Math.min(cur + 1, dots.length - 1));
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
      e.preventDefault();
      scrollToSection(Math.max(cur - 1, 0));
    }
  });

  function openInquiry(title, year, medium, dims) {
    document.getElementById('inquiry-artwork').value = `${title}, ${year}, ${medium}, ${dims}`;
    document.getElementById('inquiry-artwork-label').textContent = `${title}, ${year} · ${medium} · ${dims}`;
    document.getElementById('inquiry-modal').classList.add('open');
    document.body.classList.add('overflow-hidden');
  }
  function closeInquiry() {
    document.getElementById('inquiry-modal').classList.remove('open');
    document.body.classList.remove('overflow-hidden');
  }
  async function submitInquiry(e) {
    e.preventDefault();
    const form = e.target;
    const data = {
      type: 'inquiry',
      name: form.name.value,
      email: form.email.value,
      message: form.message.value,
      artwork: document.getElementById('inquiry-artwork').value,
      source: 'jaime-sancorlo-online'
    };
    try {
      const res = await fetch('https://caelis-subscribe.shufang0026.workers.dev/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        document.getElementById('inquiry-success').classList.remove('hidden');
        form.reset();
        setTimeout(() => { closeInquiry(); document.getElementById('inquiry-success').classList.add('hidden'); }, 2500);
      }
    } catch { alert('Something went wrong. Please email info@caelis.cn'); }
  }
</script>
