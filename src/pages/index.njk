---
layout: base.njk
title: Home
permalink: "/"
---

<!-- Hero — Pace style fullscreen slideshow -->
<section class="relative h-screen overflow-hidden bg-black" id="hero-slideshow">
  <!-- Slides -->
  <div class="absolute inset-0">
    <!-- Slide 1: August Vilella (VIDEO) -->
    <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out" data-index="0" data-has-video="true">
      <a href="/exhibitions/august-vilella-shenzhen/" class="block w-full h-full cursor-pointer relative">
        <!-- Video background -->
        <video
          id="hero-video-0"
          class="absolute inset-0 w-full h-full object-cover"
          src="/images/exhibitions/august-vilella-shenzhen/event-video.mp4"
          autoplay muted loop playsinline
          poster="/images/artworks/august-vilella-shenzhen/640-1.webp"
        ></video>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-16 pb-16 lg:pb-24">
          <div class="max-w-7xl mx-auto">
            <p class="text-white/50 text-[10px] tracking-[0.3em] uppercase mb-4 font-body">Shenzhen</p>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl xl:text-7xl text-white font-light leading-[1.1] mb-3">Between Universe and Forest</h2>
            <p class="text-white/60 text-base lg:text-lg font-body">August Vilella</p>
          </div>
        </div>
      </a>
    </div>

    <!-- Slide 2: Jaime Sancorlo Online -->
    <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out pointer-events-none" data-index="1">
      <a href="/exhibitions/jaime-sancorlo-online/" class="block w-full h-full cursor-pointer">
        <div class="absolute inset-0 bg-cover bg-center"
          style="background-image: url(/images/artworks/jaime-sancorlo/on-ice-89x130cm-2023.jpg)"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-16 pb-16 lg:pb-24">
          <div class="max-w-7xl mx-auto">
            <p class="text-white/50 text-[10px] tracking-[0.3em] uppercase mb-4 font-body">Online Exhibition</p>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl xl:text-7xl text-white font-light leading-[1.1] mb-3">Reach Out</h2>
            <p class="text-white/60 text-base lg:text-lg font-body">Jaime Sancorlo</p>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Controls: Sound + Play/Pause + Progress bars (Pace style) -->
  <div class="absolute bottom-8 left-8 lg:bottom-12 lg:left-16 z-20 flex items-center gap-4">
    <!-- Sound toggle -->
    <button id="hero-sound-btn" class="w-11 h-11 flex items-center justify-center border border-white/40 hover:border-white/80 hover:bg-white/10 transition-all" aria-label="Unmute video">
      <svg id="hero-icon-muted" class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l-3 2.25v3l3 2.25V8.25z"/><line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg id="hero-icon-unmuted" class="w-4 h-4 text-white hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l-3 2.25v3l3 2.25V8.25z"/></svg>
    </button>

    <!-- Play / Pause button -->
    <button id="hero-play-btn" class="w-11 h-11 flex items-center justify-center border border-white/40 hover:border-white/80 hover:bg-white/10 transition-all group" aria-label="Play slideshow">
      <svg id="hero-icon-play" class="w-4 h-4 text-white hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      <svg id="hero-icon-pause" class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>

    <!-- Progress bars -->
    <div id="hero-progress" class="flex items-center gap-2.5">
      <div class="progress-bar w-12 sm:w-16 lg:w-24 h-[1.5px] bg-white/30 relative overflow-hidden cursor-pointer" data-index="0">
        <div class="progress-fill absolute left-0 top-0 h-full bg-white/80 w-full origin-left scale-x-0"></div>
      </div>
      <div class="progress-bar w-12 sm:w-16 lg:w-24 h-[1.5px] bg-white/30 relative overflow-hidden cursor-pointer" data-index="1">
        <div class="progress-fill absolute left-0 top-0 h-full bg-white/80 w-full origin-left scale-x-0"></div>
      </div>
    </div>
  </div>
</section>

<!-- Current Exhibitions -->
<section class="py-20 lg:py-32 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-16">
      <div>
        <p class="text-[11px] tracking-[0.3em] uppercase mb-3 text-muted font-body">Now Showing</p>
        <h2 class="font-display text-3xl lg:text-4xl font-light text-text">Current Exhibitions</h2>
      </div>
      <a href="/exhibitions/" class="hidden sm:flex items-center text-[11px] tracking-[0.2em] uppercase text-text hover:text-primary transition-colors">
        View All
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16">
      <!-- August Vilella -->
      <a href="/exhibitions/august-vilella-shenzhen/" class="group cursor-pointer block">
        <div class="aspect-[4/3] overflow-hidden mb-8">
          <div class="w-full h-full bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105"
            style="background-image: url(/images/artworks/august-vilella-shenzhen/640-1.webp)"></div>
        </div>
        <p class="text-[11px] tracking-[0.2em] uppercase mb-3 text-muted font-body">Mar 15 — Jun 30, 2026</p>
        <h3 class="font-display text-2xl lg:text-3xl font-normal mb-3 text-text group-hover:text-primary transition-colors leading-tight">Between Universe and Forest</h3>
        <p class="text-sm text-secondary">August Vilella · Shenzhen Bay MixC</p>
      </a>
      <!-- Jaime Sancorlo Online -->
      <a href="/exhibitions/jaime-sancorlo-online/" class="group cursor-pointer block">
        <div class="aspect-[4/3] overflow-hidden mb-8">
          <div class="w-full h-full bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105"
            style="background-image: url(/images/artworks/jaime-sancorlo/on-ice-89x130cm-2023.jpg)"></div>
        </div>
        <p class="text-[11px] tracking-[0.2em] uppercase mb-3 text-muted font-body">Online</p>
        <h3 class="font-display text-2xl lg:text-3xl font-normal mb-3 text-text group-hover:text-primary transition-colors leading-tight">Reach Out</h3>
        <p class="text-sm text-secondary">Jaime Sancorlo · Online Exhibition</p>
      </a>
    </div>
  </div>
</section>

<!-- Art Insight Preview -->
<section class="py-20 lg:py-32 px-4 sm:px-6 lg:px-8 bg-surface">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-16">
      <div>
        <p class="text-[11px] tracking-[0.3em] uppercase mb-3 text-muted font-body">From the Journal</p>
        <h2 class="font-display text-3xl lg:text-4xl font-light text-text">Art Insight</h2>
      </div>
      <a href="/art-insight/" class="hidden sm:flex items-center text-[11px] tracking-[0.2em] uppercase text-text hover:text-primary transition-colors">
        Read More
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {% for article in (collections.articles | limit(3)) %}
      <a href="{{ article.url }}" class="group cursor-pointer block">
        <div class="aspect-[3/2] overflow-hidden mb-6">
          <div class="w-full h-full bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105"
            {% if article.data.cover %}style="background-image: url({{ article.data.cover }})"{% endif %}></div>
        </div>
        <p class="text-[11px] tracking-[0.2em] uppercase mb-3 text-muted font-body">{{ article.data.category }}</p>
        <h3 class="font-display text-xl lg:text-2xl font-normal mb-4 leading-snug text-text group-hover:text-primary transition-colors">{{ article.data.title }}</h3>
        <p class="text-sm text-secondary">{{ article.data.date | dateFormat }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <h2 class="font-display text-2xl lg:text-3xl font-light mb-0 text-text leading-[1.4]">Join our mailing list for updates about our artists, exhibitions, events, and more.</h2>
    <div id="subscribe-form-wrapper" class="hidden mt-12">
      <form action="https://caelis-subscribe-production.shufang0026.workers.dev/subscribe" method="POST" class="space-y-8" id="subscribe-form">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <input type="text" name="firstName" placeholder="First Name" required class="w-full bg-transparent border-b border-gray-300 pb-3 text-text placeholder:text-gray-400 focus:outline-none focus:border-text transition-colors text-base" />
          <input type="text" name="lastName" placeholder="Last Name" required class="w-full bg-transparent border-b border-gray-300 pb-3 text-text placeholder:text-gray-400 focus:outline-none focus:border-text transition-colors text-base" />
        </div>
        <input type="email" name="email" placeholder="Email" required class="w-full bg-transparent border-b border-gray-300 pb-3 text-text placeholder:text-gray-400 focus:outline-none focus:border-text transition-colors text-base" />
        <input type="text" name="country" placeholder="Country" required class="w-full bg-transparent border-b border-gray-300 pb-3 text-text placeholder:text-gray-400 focus:outline-none focus:border-text transition-colors text-base" />
        <button type="submit" class="mt-2 inline-flex items-center text-[11px] tracking-[0.25em] uppercase text-white bg-black px-8 py-3.5 hover:bg-text transition-colors cursor-pointer">Submit</button>
      </form>
      <p id="subscribe-message" class="mt-8 text-sm hidden"></p>
    </div>
    <button type="button" id="subscribe-toggle" class="mt-10 inline-flex items-center text-[11px] tracking-[0.25em] uppercase text-white bg-black px-8 py-3.5 hover:bg-text transition-all duration-200 cursor-pointer">Subscribe</button>
  </div>
</section>

<script>
(function() {
  /* ===== Sound toggle ===== */
  var soundBtn = document.getElementById('hero-sound-btn');
  var iconMuted = document.getElementById('hero-icon-muted');
  var iconUnmuted = document.getElementById('hero-icon-unmuted');
  var isMuted = true;

  function getActiveVideo() {
    var slide = document.querySelector('.hero-slide[data-index="' + current + '"]');
    return slide ? slide.querySelector('video') : null;
  }

  if (soundBtn) {
    soundBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      isMuted = !isMuted;
      // Toggle current video's sound
      var vid = getActiveVideo();
      if (vid) vid.muted = isMuted;
      // Update icon
      iconMuted.classList.toggle('hidden', !isMuted);
      iconUnmuted.classList.toggle('hidden', isMuted);
      soundBtn.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');
    });
  }

  /* ===== Hero Slideshow (Pace Gallery style) ===== */
  var slides = document.querySelectorAll('.hero-slide');
  var progressBars = document.querySelectorAll('.progress-bar');
  var playBtn = document.getElementById('hero-play-btn');
  var iconPlay = document.getElementById('hero-icon-play');
  var iconPause = document.getElementById('hero-icon-pause');
  var SLIDE_INTERVAL = 6000; // 6s per slide
  var current = 0;
  var playing = true;
  var timer = null;
  var startTime = null;
  var pausedAt = 0;

  function goTo(index, immediate) {
    if (index === current && !immediate) return;
    // Mute video on outgoing slide
    var prevVideo = document.querySelector('.hero-slide[data-index="' + current + '"] video');
    if (prevVideo) prevVideo.muted = true;

    slides.forEach(function(s, i) {
      s.classList.toggle('opacity-100', i === index);
      s.classList.toggle('opacity-0', i !== index);
      s.classList.toggle('pointer-events-none', i !== index);
    });
    current = index;

    // Apply current mute state to incoming video
    var nextVideo = document.querySelector('.hero-slide[data-index="' + current + '"] video');
    if (nextVideo) nextVideo.muted = isMuted;

    resetProgress(immediate);
  }

  function resetProgress(immediate) {
    progressBars.forEach(function(bar, i) {
      var fill = bar.querySelector('.progress-fill');
      if (i === current) {
        fill.style.transition = immediate ? 'none' : 'transform ' + SLIDE_INTERVAL + 'ms linear';
        fill.style.transform = 'scaleX(1)';
      } else {
        fill.style.transition = 'none';
        fill.style.transform = 'scaleX(0)';
      }
    });
    startTime = performance.now();
  }

  function next() {
    goTo((current + 1) % slides.length);
  }

  function startTimer() {
    stopTimer();
    timer = setTimeout(next, SLIDE_INTERVAL);
  }

  function stopTimer() {
    if (timer) { clearTimeout(timer); timer = null; }
  }

  function pause() {
    playing = false;
    stopTimer();
    pausedAt = performance.now() - startTime;
    // freeze current progress bar
    var activeBar = document.querySelector('.progress-bar[data-index="' + current + '"] .progress-fill');
    if (activeBar) {
      var pct = Math.min(pausedAt / SLIDE_INTERVAL, 1);
      activeBar.style.transition = 'none';
      activeBar.style.transform = 'scaleX(' + pct + ')';
    }
    iconPlay.classList.remove('hidden');
    iconPause.classList.add('hidden');
  }

  function resume() {
    playing = true;
    // resume progress bar with remaining time
    var remaining = SLIDE_INTERVAL - pausedAt;
    if (remaining <= 0) { next(); return; }
    var activeBar = document.querySelector('.progress-bar[data-index="' + current + '"] .progress-fill');
    if (activeBar) {
      var pct = pausedAt / SLIDE_INTERVAL;
      activeBar.style.transition = 'transform ' + remaining + 'ms linear';
      activeBar.style.transform = 'scaleX(1)';
    }
    startTimer();
    setTimeout(next, remaining);
    iconPlay.classList.add('hidden');
    iconPause.classList.remove('hidden');
  }

  // Play/pause button
  if (playBtn) {
    playBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (playing) pause(); else resume();
    });
  }

  // Click on progress bar to jump
  progressBars.forEach(function(bar) {
    bar.addEventListener('click', function(e) {
      e.stopPropagation();
      var idx = parseInt(this.dataset.index);
      goTo(idx);
      if (!playing) { pausedAt = 0; resume(); } else { startTimer(); setTimeout(next, SLIDE_INTERVAL); }
    });
  });

  // Start
  resetProgress(true);
  startTimer();

  /* ===== Newsletter ===== */
  var toggle = document.getElementById('subscribe-toggle');
  var wrapper = document.getElementById('subscribe-form-wrapper');
  var form = document.getElementById('subscribe-form');
  var message = document.getElementById('subscribe-message');
  if (!toggle || !wrapper) return;
  toggle.addEventListener('click', function() {
    wrapper.classList.remove('hidden');
    toggle.classList.add('hidden');
    var firstInput = wrapper.querySelector('input[name=firstName]');
    if (firstInput) firstInput.focus();
  });
  if (form && message) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var submitBtn = form.querySelector('button[type=submit]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      try {
        var resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        var data = await resp.json();
        if (resp.ok) {
          message.textContent = data.message;
          message.className = 'mt-6 text-sm text-green-600';
          message.classList.remove('hidden');
          form.reset();
        } else {
          message.textContent = data.error || 'Something went wrong. Please try again.';
          message.className = 'mt-6 text-sm text-red-600';
          message.classList.remove('hidden');
        }
      } catch (err) {
        message.textContent = 'Network error. Please check your connection and try again.';
        message.className = 'mt-6 text-sm text-red-600';
        message.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subscribe';
    });
  }
})();
</script>